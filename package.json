{
	"name": "pi-session-callbacks",
	"version": "0.1.0",
	"description": "Durable background jobs and per-session callback streams for the pi coding agent",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/alexei-ciobanu/pi-session-callbacks",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexei-ciobanu/pi-session-callbacks.git"
	},
	"bugs": {
		"url": "https://github.com/alexei-ciobanu/pi-session-callbacks/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"background-jobs",
		"callbacks"
	],
	"files": [
		"src",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "tsc --noEmit && biome check . && vitest --run"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@earendil-works/pi-ai": "^0.81.1",
		"@earendil-works/pi-coding-agent": "^0.81.1",
		"@earendil-works/pi-tui": "^0.81.1",
		"@types/node": "^24.0.0",
		"typebox": "^1.1.38",
		"typescript": "^6.0.0",
		"vitest": "^4.0.0"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
